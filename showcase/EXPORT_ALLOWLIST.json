{
  "description": "Allowlist for public MeowWatch-releases export.",
  "paths": [
    "showcase/assets/logo.png",
    "showcase/assets/hero.png",
    "showcase/assets/architecture.svg",
    "showcase/assets/social-preview.svg",
    "showcase/README.template.md"
  ],
  "generated": ["README.md"],
  "output": {
    "outputPaths": ["README.md", "assets/**"],
    "requiredPaths": ["README.md", "assets/hero.png", "assets/architecture.svg", "assets/logo.png"]
  },
  "neverExport": ["lib/**", "windows/**", "tool/**", "test/**", "showcase/showcase.json"]
}
